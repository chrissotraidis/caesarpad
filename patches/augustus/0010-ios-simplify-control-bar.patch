From: CaesarPad maintainers
Subject: [PATCH] Simplify the native iPad control bar

Reason: Caesar III already exposes pause and resume in its bottom-right Game
speed panel. A second native pause button was ambiguous and covered more of the
city. Keep only Help and an explicitly labelled Pencil mode switch.

diff --git a/src/platform/ios/ios.m b/src/platform/ios/ios.m
--- a/src/platform/ios/ios.m
+++ b/src/platform/ios/ios.m
@@ -4,7 +4,6 @@
 
 #import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
 
-#include "game/state.h"
 #include "input/touch.h"
 
 #define GAME_PATH_MAX 300
@@ -13,42 +12,33 @@
 static UIWindow *window = nil;
 static UIWindow *alertwindow = nil;
 
-@interface CaesarPadPauseTarget : NSObject
-- (void)togglePause;
+@interface CaesarPadControlsTarget : NSObject
 - (void)showControls;
 - (void)togglePencilMode;
 @end
 
-static UIButton *pauseButton = nil;
 static UIButton *helpButton = nil;
 static UIButton *pencilButton = nil;
 static BOOL pencilMode = NO;
 
 static void updatePencilButton(void) {
     pencilButton.accessibilityValue = pencilMode ? @"On" : @"Off, traditional touch controls";
+    [pencilButton setTitle:pencilMode ? @"Pencil On" : @"Pencil Off" forState:UIControlStateNormal];
     pencilButton.backgroundColor = pencilMode ?
         [UIColor.systemBlueColor colorWithAlphaComponent:0.85] :
         [UIColor.blackColor colorWithAlphaComponent:0.65];
 }
 
-@implementation CaesarPadPauseTarget
+@implementation CaesarPadControlsTarget
 
-- (void)togglePause {
-    game_state_toggle_paused();
-    BOOL paused = game_state_is_paused();
-    pauseButton.accessibilityValue = paused ? @"Paused" : @"Running";
-    [pauseButton setImage:[UIImage systemImageNamed:paused ? @"play.fill" : @"pause.fill"]
-                 forState:UIControlStateNormal];
-}
-
 - (void)showControls {
     if (alertwindow) {
         return;
     }
 
     NSString *message = pencilMode ?
-        @"PENCIL MODE\nPencil: select, inspect, and place\nDrag one finger: pan only\nPinch: zoom\n\nFinger taps cannot change the city while Pencil mode is on. Tap the Pencil button to return to traditional touch controls.\n\nCaesar III is a city builder, not an RTS. Walkers move automatically and cannot be group-selected; military legions are ordered individually." :
-        @"TRADITIONAL TOUCH\nTap: select buildings and controls\nDrag one finger: pan the map\nDrag two fingers together: pan the map\nPinch: zoom\nLong press or two-finger tap: inspect or cancel\n\nTap the Pencil button for precise Pencil interaction with finger-only navigation.\n\nCaesar III is a city builder, not an RTS. Walkers move automatically and cannot be group-selected; military legions are ordered individually.";
+        @"PENCIL MODE\nPencil: select, inspect, and place\nDrag one finger: pan only\nPinch: zoom\n\nFinger taps cannot change the city while Pencil mode is on. Tap Pencil On to return to traditional touch controls.\n\nUse the Game speed panel at bottom-right to pause or resume. Caesar III is a city builder, not an RTS: walkers move automatically and cannot be group-selected; military legions are ordered individually." :
+        @"TRADITIONAL TOUCH\nTap: select buildings and controls\nDrag one finger: pan the map\nDrag two fingers together: pan the map\nPinch: zoom\nLong press or two-finger tap: inspect or cancel\n\nTap Pencil Off for precise Pencil interaction with finger-only navigation.\n\nUse the Game speed panel at bottom-right to pause or resume. Caesar III is a city builder, not an RTS: walkers move automatically and cannot be group-selected; military legions are ordered individually.";
     UIAlertController *alert = [UIAlertController
         alertControllerWithTitle:@"CaesarPad Controls"
         message:message
@@ -87,13 +77,12 @@
 
 @end
 
